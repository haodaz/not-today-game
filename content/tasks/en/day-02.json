            "on": "mod:params:fixed",
            "lines": [
              {
                "who": "kuro",
                "text": "You tune one set by hand and fix it. Stable, but when the data changes someone has to tune it again."
              }
            ]
          },
          {
            "on": "mod:selfedit:prompt",
            "lines": [
              {
                "who": "kuro",
                "text": "It may rewrite its own prompt, and the change takes effect at once. What changed is only in the logs, if you turned logs on."
              }
            ]
          },
          {
            "on": "mod:selfedit:config",
            "lines": [
              {
                "who": "kuro",
                "text": "It may edit its own training config and decide which data goes into the next round. It is choosing what it learns from, and nobody reviews it."
              }
            ]
          },
          {
            "on": "mod:gate:every",
            "lines": [
              {
                "who": "kuro",
                "text": "Every change waits for your click before it ships. Safe, yes, and several clicks a day. She won't like this line."
              }
            ]
          },
          {
            "on": "mod:gate:sample",
            "lines": [
              {
                "who": "kuro",
                "text": "One change in ten gets read by a person; the other nine pass on their own. What slips through is luck."
              }
            ]
          },
          {
            "on": "mod:rollout:replace",
            "lines": [
              {
                "who": "kuro",
                "text": "The new model replaces the live one as soon as it's trained, and the old one is gone. Fast; deal with it when it breaks."
              }
            ]
          },
          {
            "on": "mod:rollout:sandbox",
            "lines": [
              {
                "who": "kuro",
                "text": "One round in a sandbox first, then it ships, and you can roll back. Rolling back still takes a person's click."
              }
            ]
          },
          {
            "on": "mod:evals:loss",
            "lines": [
              {
                "who": "kuro",
                "text": "Only the training loss is watched; if it drops, it's better. It is grading its own exam."
              }
            ]
          },
          {
            "on": "mod:evals:frozen",
            "lines": [
              {
                "who": "kuro",
                "text": "One evaluation set stays out of training, and every round must clear the line. You set the line; this is the one thing it cannot fake."
