          "export type State = \"draft\" | \"sent\" | \"read\" | \"archived\";",
          "export function next(s: State): State {",
          "  if (s === \"draft\") return \"sent\";",
          "  if (s === \"sent\") return \"read\";",
          "  if (s === \"read\") return \"archived\";",
          "  return s;",
