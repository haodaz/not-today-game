        }
      ]
    },
    "desk": {
      "say": [
        {
          "k": "narration",
          "t": "你拿起小鸡，翻到背面。那个小孔，黑的。",
          "me": "chick"
        },
        {
          "k": "narration",
          "t": "当年戳了也没用。你还是戳了一下。"
        },
        {
          "k": "inner",
          "t": "塑料的回弹。和当年一样。"
        }
      ]
    },
    "shutdown": {
      "say": [
        {
          "k": "narration",
          "t": "右下角的小窗亮着。你没有立刻躺下。",
          "where": "room",
          "me": "tired"
        }
      ]
    },
    "night": {
      "say": [
        {
          "k": "narration",
          "t": "关屏之前，你把后台的页面又点开了一次。四根条停在下午的位置。小张的消息停在「明天我接着跑」。"
        },
        {
          "k": "inner",
          "t": "能做到的程度，就这么多。明天再说。"
        },
        {
          "k": "narration",
          "t": "睡前你又把拍立得拿起来。快门还是那么硬，按下去要用一点力，像在按一个不想被按的东西。"
        },
        {
          "k": "narration",
          "t": "小学最后一个夏天，六月。教室后门整天开着，太阳从后门照进来，一直照到讲台，粉笔灰在光里一粒一粒地飘。你坐在倒数第二排靠窗的位子，桌上有一道用小刀划的线，是上一个用这张桌子的人留下的。",
          "backdrop": "/room/dream/classroom.jpg"
        },
        {
          "k": "narration",
          "t": "那时候你不太会跟人说话。相机是你带去学校的，爸爸出差带回来的，一盒相纸十张。你拍窗台上的粉笔盒，拍擦了一半的黑板，拍放学以后没人的走廊。没有人的地方，拍出来才像你看见的样子。"
        },
        {
          "k": "narration",
          "t": "毕业前一个星期，课间，不知道谁先看见的。",
          "backdrop": "/room/dream/campus_2000.jpg"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "诶，这个按一下就出照片？真的假的，给我拍一张！"
        },
        {
          "k": "inner",
          "t": "好。你站好。"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "不是不是，相机给我，我给你拍一张。你老拍那些窗户干什么。"
        },
        {
          "k": "narration",
          "t": "你把相机递过去。她举起来，对着你，按了。相纸吐出来一半，她就扯走了，举到太阳底下晃，说要晒一晒才显得快。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "拍我拍我！"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "排队！一人一张！后面的别挤！"
        },
        {
          "k": "narration",
          "t": "相机从这只手传到那只手。有人拍鬼脸，有人拍讲台上老师的背影，有人把相机举过头顶随便按了一下。你站在边上，看它越传越远，像一件本来就是大家的东西。"
        },
        {
          "k": "speaker",
          "who": "班长",
          "t": "还有几张？"
        },
        {
          "k": "inner",
          "t": "十张。九张了。八张。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "诶，你也来，站中间！拍你的相机，得有你吧！"
        },
        {
          "k": "narration",
          "t": "你站进去。前排蹲着，后排踮脚，有人喊一二三，有人喊茄子，闪了一下。"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "显出来了显出来了——哎，你闭眼了。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "再来一张！……这张，就剩你半个肩膀。你往边上躲什么。"
        },
        {
          "k": "speaker",
          "who": "班长",
          "t": "没纸了。算了算了，下次。"
        },
        {
          "k": "narration",
          "t": "没有下次了。那天剩下的照片，大家分了，一人一张，上面都是别人。你分到的那张是走廊，没有人的走廊，你自己拍的。"
        },
        {
          "k": "narration",
          "t": "上初中以后你给其中几个写过信，地址是毕业那天抄在课本封底的。写了三封，寄了两封。没有人回。后来你想，大概是地址抄错了。"
        },
        {
          "k": "inner",
          "t": "几十张照片。没有一张里有我。"
        },
        {
          "k": "narration",
          "t": "桌上现在那台，相纸是新的。你要是拍，拍的大概还是窗台、黑板那一类：没有人的地方。"
        },
        {
          "k": "narration",
          "t": "今天过去了。"
        }
      ]
    }
  },
