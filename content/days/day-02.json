        },
        {
          "k": "narration",
          "t": "你把相机递过去。她举起来，按了。相纸吐出来一半，她就扯走了。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "拍我拍我！"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "排队！一人一张！"
        },
        {
          "k": "narration",
          "t": "相机从这只手到那只手。你站在边上，看它越走越远。"
        },
        {
          "k": "speaker",
          "who": "班长",
          "t": "还有几张？"
        },
        {
          "k": "inner",
          "t": "十张。九张了。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "诶，你也来，站中间！"
        },
        {
          "k": "narration",
          "t": "你站进去。有人喊一二三，有人喊茄子，闪了一下。"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "显出来了显出来了——哎，你闭眼了。"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "再来一张！……这张，就剩你半个肩膀。"
        },
        {
          "k": "speaker",
          "who": "班长",
          "t": "没纸了。算了算了，下次。"
        },
        {
          "k": "narration",
          "t": "没有下次了。那天剩下的照片，大家分了，一人一张，上面都是别人。"
        },
        {
          "k": "narration",
          "t": "上初中以后你给其中几个写过信。地址是毕业那天抄的。"
        },
        {
          "k": "narration",
          "t": "没有人回。"
        },
        {
          "k": "inner",
          "t": "几十张照片。没有一张里有我。"
        },
        {
          "k": "narration",
          "t": "今天过去了。"
        }
      ]
    }
