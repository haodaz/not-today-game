        }
      ]
    },
    "rise": {
      "say": [
        {
          "k": "narration",
          "t": "屋子和昨天一样。雨小了一点，窗玻璃上的水珠停在原地。",
          "me": "stand"
        }
      ]
    },
    "box": {
