        {
          "k": "narration",
          "t": "A hand comes out of the gap, in a glove that fits very well."
        }
      ],
      "choices": [
        {
          "text": "Give it nothing.",
          "effects": {
            "san": -1
          },
          "say": [
            {
              "k": "narration",
              "t": "The glove comes off; underneath is another glove. It nods to you, as if in a meeting."
            },
            {
              "k": "inner",
              "t": "It isn't in a hurry. It has a thousand faces and a thousand nights."
            }
          ]
        }
      ]
    },
    "night": {
      "say": [
        {
          "k": "narration",
          "t": "In the dream it comes. Black, round, eight tentacles tucked under it. It sits on the edge of your desk."
        },
        {
          "k": "speaker",
          "who": "缝里",
          "t": "I was in the last two dreams."
        },
        {
          "k": "speaker",
          "who": "缝里",
          "t": "The drawer was yours. The corridor was theirs. This one is mine."
        },
        {
          "k": "narration",
          "t": "It doesn't ask you for anything. It looks at you a long time, like reading a line of very small print."
        },
        {
          "k": "inner",
          "t": "What it is, what it wants, that it has been watching me all along. I know all three at once."
        },
        {
          "k": "narration",
          "t": "The day is over."
        }
      ]
    }
  },
