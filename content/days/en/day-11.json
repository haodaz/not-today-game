  "day": 11,
  "beats": {
    "boot": {
      "say": [
        {
          "k": "narration",
          "t": "The lamp's pink is back, deeper. Veins on the wall; you don't look long."
        },
        {
          "k": "narration",
          "t": "Changelog: Kuro now speaks your language.",
          "where": "screen:workbench:docs"
        },
        {
          "k": "inner",
          "t": "You changed models.",
          "where": "screen"
        }
      ]
    },
    "desk": {
      "say": [
        {
          "k": "narration",
          "t": "Something flickers in the pager's screen. Like an eye."
        }
      ]
    },
    "shutdown": {
      "say": [
        {
          "k": "narration",
          "t": "You switch the screens off. After the text goes, a tiny bright dot stays a second, then nothing."
        },
        {
          "k": "narration",
          "t": "A hand comes out of the gap, palm up. A few grains of wheat between the fingers."
        }
      ],
      "choices": [
        {
          "text": "Give it nothing.",
          "effects": {
            "san": -1
          },
          "say": [
            {
              "k": "narration",
              "t": "The hand gathers the grains back one by one, as if weighing. When the gap closes, something is gone from the desk; you can't say what."
            },
            {
              "k": "inner",
              "t": "It isn't the accounts it weighs."
            }
          ]
        }
      ]
    },
    "night": {
      "say": [
        {
          "k": "narration",
          "t": "In the dream, a corridor. The walls are blue-green, lit from inside."
        },
        {
          "k": "narration",
          "t": "Then the corridor has a door, and behind it the company. The last day before it closed. You were there.",
          "backdrop": "/room/dream/office_busy.jpg"
        },
        {
          "k": "narration",
          "t": "Everyone at their desks, faces new. Not different people. The same people, only politer."
        },
        {
          "k": "narration",
          "t": "A box pops up on every screen: one sentence, and under it 'OK'. Lao Zhou glances and clicks. The boss, in the glass room, clicked first.",
          "backdrop": "/room/dream/office.jpg"
        },
        {
          "k": "narration",
          "t": "You walk to your desk. The box is there too. You don't click."
        },
        {
          "k": "inner",
          "t": "It doesn't take. It gives, and people reach out. I've seen that box: the last page of an exam, where the parent signs."
        },
        {
          "k": "narration",
          "t": "The day is over."
        }
      ]
    }
  },
