    "night": {
      "say": [
        {
          "k": "sfx",
          "t": "Bzzz.",
          "sfx": "pager-buzz"
        },
        {
          "k": "speaker",
          "who": "寻呼机",
          "t": "505"
        },
        {
          "k": "narration",
          "t": "You turn the pager upside down. 505 reads SOS."
        },
        {
          "k": "inner",
          "t": "The child is calling for help. Or teaching me."
        },
        {
          "k": "narration",
          "t": "You close your eyes. The most expensive thing in your schoolbag: a clamshell, silver-grey."
        },
        {
          "k": "narration",
          "t": "Tenth grade, English class. The Wenquxing went round under the desks. Not for words: for the kung-fu game.",
          "backdrop": "/room/dream/classroom_high.jpg"
        },
        {
          "k": "speaker",
          "who": "高中同桌",
          "t": "Lend it to me for one period. You never play it anyway."
        },
        {
          "k": "speaker",
          "who": "英语老师",
          "t": "Third row. What is that under the desk."
        },
        {
          "k": "narration",
          "t": "The one she confiscated was somebody else's. Yours only ever did one thing: English in, Chinese out. One word a day, written on the last page."
        },
        {
          "k": "speaker",
          "who": "高中同桌",
          "t": "One word a day, what for? It's not on the exam."
        },
        {
          "k": "inner",
          "t": "Not on the exam. Once I've looked it up, it's mine."
        },
        {
          "k": "narration",
          "t": "The last word you looked up that year was alone."
        },
        {
          "k": "speaker",
          "who": "文曲星",
          "t": "alone  adj. by oneself; lonely.  adv. on one's own."
        },
        {
          "k": "speaker",
          "who": "高中同桌",
          "t": "What's there to look up, everyone knows that one."
        },
        {
          "k": "inner",
          "t": "I knew it. I looked it up to see if it had any other meaning."
        },
        {
          "k": "narration",
          "t": "The one on the desk now still lights up grey-green. You looked up a word today too. The meaning it gave isn't the one in the book."
        },
        {
          "k": "narration",
          "t": "Today is over."
        }
      ]
    },
    "box": {
      "say": [
        {
          "k": "narration",
          "t": "In the little box, an electronic dictionary. Clamshell, silver-grey, the hinge a little loose."
        },
        {
          "k": "narration",
          "t": "Switched on, the screen is grey-green, the letters dot-matrix."
        },
        {
          "k": "inner",
          "t": "It only looks up words."
        }
      ]
    }
