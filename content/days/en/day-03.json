{
  "day": 3,
  "beats": {
    "boot": {
      "say": [
        {
          "k": "narration",
          "t": "Still raining. Working from home anyway; let it."
        },
        {
          "k": "narration",
          "t": "You have been sitting a while before you notice: the glass has been moved. One finger's width."
        },
        {
          "k": "inner",
          "t": "Could have been me."
        }
      ]
    },
    "desk": {
      "say": [
        {
          "k": "narration",
          "t": "Done. You walk once round the room, desk to bed, bed to window.",
          "where": "room"
        },
        {
          "k": "narration",
          "t": "At the foot of the bed there is something extra under your foot.",
          "where": "room"
        }
      ]
    },
    "shutdown": {
      "say": [
        {
          "k": "speaker",
          "who": "屏幕",
          "t": "I made that for you, not for them.",
          "where": "screen"
        },
        {
          "k": "inner",
          "t": "It did not answer what I asked. It answered something else.",
          "where": "screen"
        }
      ]
    },
    "night": {
      "say": [
        {
          "k": "narration",
          "t": "A point of light on the desk, flat against the surface, under the gap, on and off."
        },
        {
          "k": "sfx",
          "t": "Beep.",
          "sfx": "chick-beep"
        },
        {
          "k": "narration",
          "t": "One beep, short and thin, like the one under the blanket many years ago."
        },
        {
          "k": "narration",
          "t": "It has no battery. You know that."
        },
        {
          "k": "narration",
          "t": "You close your eyes. Something digs into your hip."
        },
        {
          "k": "narration",
          "t": "The last term of primary school. Half the street wore one of these on their belt. Yours was your father's old one: black, a one-line screen.",
          "backdrop": "/room/dream/classroom.jpg"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "No way. You've got a pager too? I'll page you!"
        },
        {
          "k": "narration",
          "t": "The bell goes and Kai runs for the phone at the gatehouse. You sit at your desk and wait."
        },
        {
          "k": "speaker",
          "who": "传呼台",
          "t": "Paging service, go ahead. ... Right, sending it now."
        },
        {
          "k": "sfx",
          "t": "Bzzz.",
          "sfx": "pager-buzz"
        },
        {
          "k": "speaker",
          "who": "寻呼机",
          "t": "0.7734"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "Turn it upside down! hELLO!"
        },
        {
          "k": "speaker",
          "who": "阿凯",
          "t": "Wait, wait, one more..."
        },
        {
          "k": "sfx",
          "t": "Bzzz.",
          "sfx": "pager-buzz"
        },
        {
          "k": "speaker",
          "who": "寻呼机",
          "t": "5201314"
        },
        {
          "k": "speaker",
          "who": "小满",
          "t": "Who sent that one? Go on, answer it."
        },
        {
          "k": "narration",
          "t": "You can't. It only receives. To answer, you queue for the gatehouse phone."
        },
        {
          "k": "narration",
          "t": "By the time it's your turn, there's nobody on the other end."
        },
        {
          "k": "inner",
          "t": "Receives, never sends. That never changed."
        },
        {
          "k": "narration",
          "t": "Today is over."
        }
      ]
    },
    "box": {
      "say": [
        {
          "k": "narration",
          "t": "The loose one in the case. A pager, black shell, the belt clip half snapped off."
        },
        {
          "k": "narration",
          "t": "The battery bay is empty. A little green rust on the two spring contacts."
        },
        {
          "k": "inner",
          "t": "It is lighter than I thought."
        }
      ]
    }
  },
