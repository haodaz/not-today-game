  "beats": {
    "boot": {
      "say": [
        {
          "k": "narration",
          "t": "下雨了。在家上班，不失为一个好选择。"
        },
        {
          "k": "narration",
          "t": "桌上一杯水，凉的。两块屏黑着。"
        },
        {
          "k": "inner",
          "t": "第一天。"
        }
      ]
    },
    "box": {
      "say": [
        {
          "k": "sfx",
          "t": "叮咚。",
          "sfx": "doorbell"
        },
        {
          "k": "narration",
          "t": "门口两样东西：一袋黄焖鸡，一个没有寄件人的纸箱。"
        },
        {
          "k": "narration",
          "t": "箱子上有收件人，是你的名字。"
        }
      ]
    },
    "desk": {
      "say": [
        {
          "k": "narration",
          "t": "你把它放在两块屏之间，放进那条缝里。刚好卡住，不倒。"
        },
        {
          "k": "inner",
          "t": "旧得和这个房间不是一个年代的东西。"
        }
      ]
    },
    "shutdown": {
      "say": [
        {
          "k": "narration",
          "t": "灯灭了，或者说，你关了屏幕。屋子一下子沉下去。"
        },
        {
          "k": "narration",
          "t": "没有手从缝里伸出来。今天还没有。"
        }
      ]
    },
    "night": {
      "say": [
        {
          "k": "narration",
          "t": "那道黑里有一点光。不是小鸡的壳，壳在更低的地方。"
        },
        {
          "k": "narration",
          "t": "它在缝的中间，很小，偏粉。你数到七，它还在。"
        },
        {
          "k": "inner",
          "t": "粉的。我这屋子里没有一样东西是粉的。"
        },
        {
          "k": "narration",
          "t": "今天过去了。"
        }
      ]
    }
