            "sfx": "doorbell"
          },
          {
            "k": "inner",
            "t": "外卖。还有别的。"
          }
        ]
      }
    },
    {
      "id": "eat",
      "text": "窗边饭桌，吃。",
      "unlock": "done:pickup",
