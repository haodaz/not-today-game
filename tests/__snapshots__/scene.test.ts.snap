exports[`the stage > snapshots day 1's dream: the line with backdrop, prop and portrait; then the 100 1`] = `
{
  "hundred": "<div class="stage room room-view scene-on" data-day="1" data-view="room" data-san-band="0"><div class="scene has-backdrop" aria-hidden="true"><div class="scene-backdrop" data-src="/room/dream/classroom.jpg" style="background-image:url(/room/dream/classroom.jpg)"></div><img class="scene-prop" data-src="/room/props/exam_100.png" src="/room/props/exam_100.png" alt="" draggable="false"></div><div class="list"><div class="h">今日</div><div class="it now" data-id="boot"><i></i>按一下桌底下的主机，开机。</div></div><div class="day"><b>第 1 天 · 夜里</b></div><div class="dlg" data-screen="1/1"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">期末那天她把它和成绩单一起递给你。先递成绩单，一百。再递它，屏幕上已经是那座坟。</button><span class="more" aria-hidden="true">▶</span></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="rest" aria-hidden="true"></span></button></div></div><button type="button" class="settings-btn" data-action="settings-open" aria-haspopup="dialog">⚙ 设置</button><button type="button" class="items-btn" data-action="items-toggle" aria-expanded="false" aria-controls="items-panel">道具</button></div>",
  "withPortrait": "<div class="stage room room-view scene-on" data-day="1" data-view="room" data-san-band="0"><div class="scene has-backdrop" aria-hidden="true"><div class="scene-backdrop" data-src="/room/dream/classroom.jpg" style="background-image:url(/room/dream/classroom.jpg)"></div><img class="scene-prop" data-src="/room/props/exam_96.png" src="/room/props/exam_96.png" alt="" draggable="false"></div><div class="list"><div class="h">今日</div><div class="it now" data-id="boot"><i></i>按一下桌底下的主机，开机。</div></div><div class="day"><b>第 1 天 · 夜里</b></div><div class="dlg tagged npc" data-screen="1/1"><div class="tagbar"><span class="who tag">老师</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">抽屉里是什么。拿上来。</button><span class="more" aria-hidden="true">▶</span><img class="npc-portrait" src="/npc/teacher.png" alt="" aria-hidden="true" draggable="false"></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="rest" aria-hidden="true"></span></button></div></div><button type="button" class="settings-btn" data-action="settings-open" aria-haspopup="dialog">⚙ 设置</button><button type="button" class="items-btn" data-action="items-toggle" aria-expanded="false" aria-controls="items-panel">道具</button></div>",
}
`;

