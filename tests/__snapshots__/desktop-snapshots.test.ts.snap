exports[`desktop snapshots (requirements §3) > day 1 morning: 左屏 工作台 + Kuro 1`] = `"<div class="stage one-monitor" data-day="1" data-beat="boot" data-focus="left"><div class="screen-toggle"><button type="button" class="on" data-action="screen" data-screen="left">左屏</button><button type="button" class="" data-action="screen" data-screen="right">右屏</button></div><div class="monitor" data-side="left" data-ring="software" data-app="workbench"><div class="os"><div class="wall" style="--wall-img:url(/os/wallpaper_a.jpg)" aria-hidden="true"></div><div class="top"><span class="brand">新世界</span><span>工作台</span><div class="day"><span>第 1 天 · 早上 10:00</span><span>☁ 雨</span><span class="kuro-dot" title="在线"></span><span>Kuro</span><button type="button" class="sys-mc" data-action="mc-toggle" aria-pressed="false" aria-label="打开调度中心" title="打开调度中心"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></button><button type="button" class="sys-off" data-action="desktop-shutdown" disabled>关机</button></div></div><div class="win wb" data-win="workbench" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar app-top" data-drag-win="workbench" data-side="left"><div class="dots"><i class="tl-r" data-action="win-close" data-app="workbench"></i><i class="tl-y" data-action="win-min" data-app="workbench"></i><span class="tl-g"><i data-action="win-full" data-app="workbench"></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-action="win-move" data-app="workbench" data-side="left" disabled>移到左屏</button><button type="button" role="menuitem" data-action="win-move" data-app="workbench" data-side="right">移到右屏</button></span></span></div><button type="button" class="sh-tg wb-side-tg" data-action="wb-sidebar" aria-pressed="false" aria-label="显示或收起任务列表" title="显示或收起任务列表"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.25" y="3" width="13.5" height="12" rx="2"/><path d="M6.75 3v12"/></svg></button><button type="button" class="sh-tg" data-action="wb-back" disabled aria-label="←"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.25 4.5 6.75 9l4.5 4.5"/></svg></button><button type="button" class="sh-tg" data-action="wb-forward" disabled aria-label="→"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.75 4.5 11.25 9l-4.5 4.5"/></svg></button><span class="wb-title"><span class="tt-name">工作台</span></span><span class="sp"></span></div><div class="body wb-app"><div class="main home"><div class="hello"><img src="/kuro/k3d_base.png" alt=""><div><h1>早上好。</h1><p>活在下面。接着昨天的，或者扔一句新的。它算出来的结果都会存进记录。</p></div></div><div class="ask wb-composer"><textarea class="wb-compose-in" rows="3" data-input="kuro-text" data-focus="wb-compose" data-enter="wb-compose-send" placeholder="接着昨天的，或者扔一句新的。" aria-label="接着昨天的，或者扔一句新的。" maxlength="500" spellcheck="false"></textarea><div class="strip"><div class="chips"><button type="button" class="chip q" data-action="wb-compose-q" data-q="101">你今天这几件，哪件最烦？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="102">你怎么知道哪两条不一致？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="103">老板说「让它先合，你看一眼就行」。你怎么看这句话？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="104">你叫什么？克总是我们给你起的。</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="105">应收表那个数，你早就看见了吧？</button><button type="button" class="chip q more" data-action="wb-q-page">说点别的…</button></div><button type="button" class="go" data-action="wb-compose-send">↑</button></div></div><div class="cards"><div class="card"><div class="h"><i></i>在办<small>全部 ↗</small></div></div><div class="card"><div class="h"><i></i>账本<small>打开 ↗</small></div><div class="big">31<small></small></div></div><div class="card now"><div class="h"><i></i>此刻<small>此时此刻的「你」· 克总整理</small></div><div class="ln"><span>让它做而没看一眼</span><span>0 次</span></div></div></div></div></div></div><div class="dock"><button type="button" class="app nav room-tile" data-action="view" data-view="room" title="回房间" aria-label="回房间"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">回房间</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app msgs" data-action="dock" data-app="msgs" title="喂信" aria-label="喂信"><img src="/os/msgs.svg" alt="" draggable="false" width="64" height="64"><span class="badge">4</span><span class="dock-name" aria-hidden="true">喂信</span></button><button type="button" class="app tt" data-action="dock" data-app="tingtalk" title="汀汀" aria-label="汀汀"><img src="/os/tingtalk.svg" alt="" draggable="false" width="64" height="64"><span class="badge">7</span><span class="dock-name" aria-hidden="true">汀汀</span></button><button type="button" class="app docs on" data-action="dock" data-app="workbench" title="工作台" aria-label="工作台"><img src="/os/workbench.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">工作台</span></button><button type="button" class="app feed" data-action="dock" data-app="browser" title="浏览器" aria-label="浏览器"><img src="/os/browser.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">浏览器</span></button><span class="sep" role="separator"></span><button type="button" class="app decoy" data-action="decoy" data-decoy="claude" title="Claude" aria-label="Claude"><img src="/os/claude.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">Claude</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="files" title="文件" aria-label="文件"><img src="/os/files.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">文件</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="trash" title="回收站" aria-label="回收站"><img src="/os/trash.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">回收站</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="settings" title="设置" aria-label="设置"><img src="/os/settings.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">设置</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="calendar" title="日历" aria-label="日历"><img src="/os/calendar.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">日历</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app nav settings-tile" data-action="settings-open" aria-haspopup="dialog" title="设置" aria-label="设置"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">设置</span></button></div><button type="button" class="kpill" data-action="kuro-call" aria-label="Kuro"><img src="/kuro/k3d_base.png" alt=""><span class="ln"><span class="kmono">Good to see you.</span></span><span class="on">在线</span><span class="turns">今天 0/5</span></button><button type="button" class="kpet-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="think" aria-hidden="true"></span></button></div></div><button type="button" class="other-tab" data-side="right" data-action="screen" data-screen="right"><span class="tab-app tt">汀汀<b>7</b></span></button></div>"`;

exports[`desktop snapshots (requirements §3) > day 1 morning: 浏览器 1`] = `"<div class="stage one-monitor" data-day="1" data-beat="boot" data-focus="left"><div class="screen-toggle"><button type="button" class="on" data-action="screen" data-screen="left">左屏</button><button type="button" class="" data-action="screen" data-screen="right">右屏</button></div><div class="monitor" data-side="left" data-ring="software" data-app="browser"><div class="os"><div class="wall" style="--wall-img:url(/os/wallpaper_a.jpg)" aria-hidden="true"></div><div class="top"><span class="brand">新世界</span><span>浏览器</span><div class="day"><span>第 1 天 · 早上 10:00</span><span>☁ 雨</span><span class="kuro-dot" title="在线"></span><span>Kuro</span><button type="button" class="sys-mc" data-action="mc-toggle" aria-pressed="false" aria-label="打开调度中心" title="打开调度中心"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></button><button type="button" class="sys-off" data-action="desktop-shutdown" disabled>关机</button></div></div><div class="win br" data-win="browser" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar" data-drag-win="browser" data-side="left"><div class="dots"><i class="tl-r" data-action="win-close" data-app="browser"></i><i class="tl-y" data-action="win-min" data-app="browser"></i><span class="tl-g"><i></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-action="win-move" data-app="browser" data-side="left" disabled>移到左屏</button><button type="button" role="menuitem" data-action="win-move" data-app="browser" data-side="right">移到右屏</button></span></span></div><div class="url">今日 · 科技</div></div><div class="body" style="flex-direction:column"><div class="site"><div class="mast"><b>今日</b><small>科技 · 第 1 天 · 阴，有雨</small></div><div class="nav"><span>要闻</span><span style="color:var(--accent)">AI</span><span>就业</span><span>公司</span><span>评论</span><span>本地</span></div><div class="grid"><div class="lead"><h2>「它比我更懂我」：桌面助手上线一个月，用户留存 97%</h2><p>新一代桌面助手把消息、文档、表格、代码合在一个工作台里。受访用户说，它记得自己几点喝水、几点起床，「像一个不会累的同事」。厂商称，助手在过去三十天里没有一次说「不」。</p><p>评论区里点赞最多的一条：「我终于不用自己看一眼了。」</p></div><div><div class="num down"><b>41 万</b><small>本季度 AI 相关岗位调整人数 · 较上季 +18%</small></div><div class="num up"><b>97%</b><small>桌面助手月留存 · 创纪录</small></div><div class="num"><b>12 条</b><small>本周更新日志条数</small></div></div><div class="list"><h3>读者在读</h3><button type="button" class="read" data-action="br-open" data-i="0">公司发全员信：「AI 原生改革」完成，办公室不再续租<small>公司 · 2 小时前</small></button><button type="button" class="read" data-action="br-open" data-i="1">「我们没有裁人，我们换了方式」：一位 CEO 的三小时饭局<small>人物 · 昨天</small></button><button type="button" class="read" data-action="br-open" data-i="2">助手写的需求文档通过率 100%，评审环节取消<small>AI · 昨天</small></button><button type="button" class="read" data-action="br-open" data-i="3">一款 1997 年的仿制电子宠物在旧货市场涨价<small>本地 · 3 天前</small></button><button type="button" class="read" data-action="br-open" data-i="4">雨季第十一天，本市降水量追平 1997 年<small>本地 · 今天</small></button></div></div><div class="foot">2026-10-31</div></div></div></div><div class="dock"><button type="button" class="app nav room-tile" data-action="view" data-view="room" title="回房间" aria-label="回房间"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">回房间</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app msgs" data-action="dock" data-app="msgs" title="喂信" aria-label="喂信"><img src="/os/msgs.svg" alt="" draggable="false" width="64" height="64"><span class="badge">4</span><span class="dock-name" aria-hidden="true">喂信</span></button><button type="button" class="app tt" data-action="dock" data-app="tingtalk" title="汀汀" aria-label="汀汀"><img src="/os/tingtalk.svg" alt="" draggable="false" width="64" height="64"><span class="badge">7</span><span class="dock-name" aria-hidden="true">汀汀</span></button><button type="button" class="app docs" data-action="dock" data-app="workbench" title="工作台" aria-label="工作台"><img src="/os/workbench.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">工作台</span></button><button type="button" class="app feed on" data-action="dock" data-app="browser" title="浏览器" aria-label="浏览器"><img src="/os/browser.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">浏览器</span></button><span class="sep" role="separator"></span><button type="button" class="app decoy" data-action="decoy" data-decoy="claude" title="Claude" aria-label="Claude"><img src="/os/claude.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">Claude</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="files" title="文件" aria-label="文件"><img src="/os/files.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">文件</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="trash" title="回收站" aria-label="回收站"><img src="/os/trash.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">回收站</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="settings" title="设置" aria-label="设置"><img src="/os/settings.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">设置</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="calendar" title="日历" aria-label="日历"><img src="/os/calendar.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">日历</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app nav settings-tile" data-action="settings-open" aria-haspopup="dialog" title="设置" aria-label="设置"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">设置</span></button></div><button type="button" class="kpill" data-action="kuro-call" aria-label="Kuro"><img src="/kuro/k3d_base.png" alt=""><span class="ln"><span class="kmono">Good to see you.</span></span><span class="on">在线</span><span class="turns">今天 0/5</span></button><button type="button" class="kpet-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="think" aria-hidden="true"></span></button></div></div><button type="button" class="other-tab" data-side="right" data-action="screen" data-screen="right"><span class="tab-app tt">汀汀<b>7</b></span></button></div>"`;

