exports[`desktop snapshots (requirements §3) > day 1: 调度中心 over both monitors (snapshot) 1`] = `"<div class="stage one-monitor" data-day="1" data-beat="work" data-focus="left"><div class="screen-toggle"><button type="button" class="on" data-action="screen" data-screen="left">左屏</button><button type="button" class="" data-action="screen" data-screen="right">右屏</button></div><div class="monitor" data-side="left" data-ring="software" data-app="workbench"><div class="os"><div class="wall" style="--wall-img:url(/os/wallpaper_a.jpg)" aria-hidden="true"></div><div class="top"><span class="brand">新世界</span><span>工作台</span><div class="day"><span>第 1 天 · 上午 10:00</span><span>☁ 雨</span><span class="kuro-dot" title="在线"></span><span>Kuro</span><button type="button" class="sys-mc on" data-action="mc-toggle" aria-pressed="true" aria-label="打开调度中心" title="打开调度中心"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></button><button type="button" class="sys-off" data-action="desktop-shutdown" disabled>关机</button></div></div><div class="win wb" data-win="workbench" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar app-top" data-drag-win="workbench" data-side="left"><div class="dots"><i class="tl-r" data-action="win-close" data-app="workbench"></i><i class="tl-y" data-action="win-min" data-app="workbench"></i><span class="tl-g"><i data-action="win-full" data-app="workbench"></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-action="win-move" data-app="workbench" data-side="left" disabled>移到左屏</button><button type="button" role="menuitem" data-action="win-move" data-app="workbench" data-side="right">移到右屏</button></span></span></div><button type="button" class="sh-tg wb-side-tg" data-action="wb-sidebar" aria-pressed="false" aria-label="显示或收起任务列表" title="显示或收起任务列表"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.25" y="3" width="13.5" height="12" rx="2"/><path d="M6.75 3v12"/></svg></button><button type="button" class="sh-tg" data-action="wb-back" disabled aria-label="←"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.25 4.5 6.75 9l4.5 4.5"/></svg></button><button type="button" class="sh-tg" data-action="wb-forward" disabled aria-label="→"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.75 4.5 11.25 9l-4.5 4.5"/></svg></button><span class="wb-title"><span class="tt-name">工作台</span></span><span class="sp"></span></div><div class="body wb-app"><div class="main home"><div class="hello"><img src="/kuro/k3d_base.png" alt=""><div><h1>早上好。</h1><p>活在下面。接着昨天的，或者扔一句新的。它算出来的结果都会存进记录。</p></div></div><div class="ask wb-composer"><textarea class="wb-compose-in" rows="3" data-input="kuro-text" data-focus="wb-compose" data-enter="wb-compose-send" placeholder="接着昨天的，或者扔一句新的。" aria-label="接着昨天的，或者扔一句新的。" maxlength="500" spellcheck="false"></textarea><div class="strip"><div class="chips"><button type="button" class="chip q" data-action="wb-compose-q" data-q="101">你今天这几件，哪件最烦？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="102">你怎么知道哪两条不一致？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="103">老板说「让它先合，你看一眼就行」。你怎么看这句话？</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="104">你叫什么？克总是我们给你起的。</button><button type="button" class="chip q" data-action="wb-compose-q" data-q="105">应收表那个数，你早就看见了吧？</button><button type="button" class="chip q more" data-action="wb-q-page">说点别的…</button></div><button type="button" class="go" data-action="wb-compose-send">↑</button></div></div><div class="cards"><div class="card"><div class="h"><i></i>在办<small>全部 ↗</small></div></div><div class="card"><div class="h"><i></i>账本<small>打开 ↗</small></div><div class="big">31<small></small></div></div><div class="card now"><div class="h"><i></i>此刻<small>此时此刻的「你」· 克总整理</small></div><div class="ln"><span>让它做而没看一眼</span><span>0 次</span></div></div></div></div></div></div><div class="dock"><button type="button" class="app nav room-tile" data-action="view" data-view="room" title="回房间" aria-label="回房间"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">回房间</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app msgs" data-action="dock" data-app="msgs" title="喂信" aria-label="喂信"><img src="/os/msgs.svg" alt="" draggable="false" width="64" height="64"><span class="badge">4</span><span class="dock-name" aria-hidden="true">喂信</span></button><button type="button" class="app tt" data-action="dock" data-app="tingtalk" title="汀汀" aria-label="汀汀"><img src="/os/tingtalk.svg" alt="" draggable="false" width="64" height="64"><span class="badge">7</span><span class="dock-name" aria-hidden="true">汀汀</span></button><button type="button" class="app docs on" data-action="dock" data-app="workbench" title="工作台" aria-label="工作台"><img src="/os/workbench.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">工作台</span></button><button type="button" class="app feed" data-action="dock" data-app="browser" title="浏览器" aria-label="浏览器"><img src="/os/browser.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">浏览器</span></button><span class="sep" role="separator"></span><button type="button" class="app decoy" data-action="decoy" data-decoy="claude" title="Claude" aria-label="Claude"><img src="/os/claude.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">Claude</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="files" title="文件" aria-label="文件"><img src="/os/files.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">文件</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="trash" title="回收站" aria-label="回收站"><img src="/os/trash.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">回收站</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="settings" title="设置" aria-label="设置"><img src="/os/settings.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">设置</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="calendar" title="日历" aria-label="日历"><img src="/os/calendar.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">日历</span></button><span class="sep nav-sep" aria-hidden="true"></span><button type="button" class="app nav settings-tile" data-action="settings-open" aria-haspopup="dialog" title="设置" aria-label="设置"><span class="glyph" aria-hidden="true"></span><span class="dock-name" aria-hidden="true">设置</span></button></div><button type="button" class="kpill" data-action="kuro-call" aria-label="Kuro"><img src="/kuro/k3d_base.png" alt=""><span class="ln"><span class="kmono">Good to see you.</span></span><span class="on">在线</span><span class="turns">今天 0/5</span></button><button type="button" class="kpet-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="think" aria-hidden="true"></span></button></div></div><button type="button" class="other-tab" data-side="right" data-action="screen" data-screen="right"><span class="tab-app tt">汀汀<b>7</b></span></button><div class="mc" role="dialog" aria-label="调度中心"><div class="mc-screens"><div class="mc-screen on" data-mc-drop="left"><div class="mc-desk"><span class="mc-mini">工作台</span></div><span class="mc-sname">左屏</span></div><div class="mc-screen" data-mc-drop="right"><div class="mc-desk"><span class="mc-mini">汀汀</span></div><span class="mc-sname">右屏</span></div></div><div class="mc-wins"><div class="mc-win" role="button" tabindex="0" data-action="mc-focus" data-app="workbench" data-side="left" data-mc-drag="workbench" aria-label="工作台"><span class="mc-thumb" aria-hidden="true"><span class="mc-scale" inert><div class="win wb" data-win="workbench" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar app-top" data-mc-drag-win="workbench" data-side="left"><div class="dots"><i class="tl-r" data-mc-action="win-close" data-app="workbench"></i><i class="tl-y" data-mc-action="win-min" data-app="workbench"></i><span class="tl-g"><i data-mc-action="win-full" data-app="workbench"></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-mc-action="win-move" data-app="workbench" data-side="left" disabled>移到左屏</button><button type="button" role="menuitem" data-mc-action="win-move" data-app="workbench" data-side="right">移到右屏</button></span></span></div><button type="button" class="sh-tg wb-side-tg" data-mc-action="wb-sidebar" aria-pressed="false" aria-label="显示或收起任务列表" title="显示或收起任务列表"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.25" y="3" width="13.5" height="12" rx="2"/><path d="M6.75 3v12"/></svg></button><button type="button" class="sh-tg" data-mc-action="wb-back" disabled aria-label="←"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.25 4.5 6.75 9l4.5 4.5"/></svg></button><button type="button" class="sh-tg" data-mc-action="wb-forward" disabled aria-label="→"><svg class="ic" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6.75 4.5 11.25 9l-4.5 4.5"/></svg></button><span class="wb-title"><span class="tt-name">工作台</span></span><span class="sp"></span></div><div class="body wb-app"><div class="main home"><div class="hello"><img src="/kuro/k3d_base.png" alt=""><div><h1>早上好。</h1><p>活在下面。接着昨天的，或者扔一句新的。它算出来的结果都会存进记录。</p></div></div><div class="ask wb-composer"><textarea class="wb-compose-in" rows="3" data-mc-input="kuro-text" data-mc-focus="wb-compose" data-mc-enter="wb-compose-send" placeholder="接着昨天的，或者扔一句新的。" aria-label="接着昨天的，或者扔一句新的。" maxlength="500" spellcheck="false"></textarea><div class="strip"><div class="chips"><button type="button" class="chip q" data-mc-action="wb-compose-q" data-q="101">你今天这几件，哪件最烦？</button><button type="button" class="chip q" data-mc-action="wb-compose-q" data-q="102">你怎么知道哪两条不一致？</button><button type="button" class="chip q" data-mc-action="wb-compose-q" data-q="103">老板说「让它先合，你看一眼就行」。你怎么看这句话？</button><button type="button" class="chip q" data-mc-action="wb-compose-q" data-q="104">你叫什么？克总是我们给你起的。</button><button type="button" class="chip q" data-mc-action="wb-compose-q" data-q="105">应收表那个数，你早就看见了吧？</button><button type="button" class="chip q more" data-mc-action="wb-q-page">说点别的…</button></div><button type="button" class="go" data-mc-action="wb-compose-send">↑</button></div></div><div class="cards"><div class="card"><div class="h"><i></i>在办<small>全部 ↗</small></div></div><div class="card"><div class="h"><i></i>账本<small>打开 ↗</small></div><div class="big">31<small></small></div></div><div class="card now"><div class="h"><i></i>此刻<small>此时此刻的「你」· 克总整理</small></div><div class="ln"><span>让它做而没看一眼</span><span>0 次</span></div></div></div></div></div></div></span></span><span class="mc-name">工作台</span></div><div class="mc-win" role="button" tabindex="0" data-action="mc-focus" data-app="tingtalk" data-side="right" data-mc-drag="tingtalk" aria-label="汀汀"><span class="mc-thumb" aria-hidden="true"><span class="mc-scale" inert><div class="win wb tt" data-win="tingtalk" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar" data-mc-drag-win="tingtalk" data-side="right"><div class="dots"><i class="tl-r" data-mc-action="win-close" data-app="tingtalk"></i><i class="tl-y" data-mc-action="win-min" data-app="tingtalk"></i><span class="tl-g"><i></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-mc-action="win-move" data-app="tingtalk" data-side="left">移到左屏</button><button type="button" role="menuitem" data-mc-action="win-move" data-app="tingtalk" data-side="right" disabled>移到右屏</button></span></span></div><span class="title">汀汀</span></div><div class="body"><div class="wb-msgs"><div class="list"><div class="search">搜索</div><button type="button" class="row" data-mc-action="conv" data-conv="boss"><span class="av-wrap"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>老板</b><small>[语音] 41″</small></div><div class="meta">08:58<br><span class="n">1</span></div></button><button type="button" class="row" data-mc-action="conv" data-conv="partner"><span class="av-wrap"><img class="av av-img" src="/npc/partner_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>Vivi</b><small>[卡片] 竞品 A 的叙事线 · 转发</small></div><div class="meta">08:40<br><span class="n">1</span></div></button><button type="button" class="row" data-mc-action="conv" data-conv="group"><span class="av-wrap"><img class="av av-img" src="/npc/sil_6.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>未来智能 · 全员</b><small>member：+1</small></div><div class="meta">09:13<br><span class="n">3</span></div></button><button type="button" class="row" data-mc-action="conv" data-conv="xiaozhang"><span class="av-wrap"><img class="av av-img" src="/npc/xiaozhang_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>小张</b><small>图谱那边二百多个节点，我昨天刚跟你对完。</small></div><div class="meta">09:41<br><span class="n">2</span></div></button><button type="button" class="row" data-mc-action="conv" data-conv="laozhou"><span class="av-wrap"><img class="av av-img" src="/npc/laozhou_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>老周</b><small></small></div><div class="meta"></div></button></div><div class="conv empty"></div></div></div></div></span></span><span class="mc-name">汀汀</span></div></div></div></div>"`;

exports[`desktop snapshots (requirements §3) > day 10 calm daytime: 右屏 听听 + Kuro 1`] = `"<div class="stage one-monitor" data-day="10" data-beat="work" data-focus="right"><div class="screen-toggle"><button type="button" class="" data-action="screen" data-screen="left">左屏</button><button type="button" class="on" data-action="screen" data-screen="right">右屏</button></div><div class="monitor" data-side="right" data-ring="software" data-app="tingtalk"><div class="os"><div class="wall" style="--wall-img:url(/os/wallpaper_a.jpg)" aria-hidden="true"></div><div class="top"><span class="brand">新世界</span><span>汀汀</span><div class="day"><span>第 10 天 · 上午 10:00</span><span>☀ 晴</span><span class="kuro-dot" title="在线"></span><span>Kuro</span><button type="button" class="sys-mc" data-action="mc-toggle" aria-pressed="false" aria-label="打开调度中心" title="打开调度中心"><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></button><button type="button" class="sys-off" data-action="desktop-shutdown" disabled>关机</button></div></div><div class="win wb tt" data-win="tingtalk" style="left:0px;top:28px;width:1440px;height:800px"><div class="bar" data-drag-win="tingtalk" data-side="right"><div class="dots"><i class="tl-r" data-action="win-close" data-app="tingtalk"></i><i class="tl-y" data-action="win-min" data-app="tingtalk"></i><span class="tl-g"><i></i><span class="win-menu" role="menu"><button type="button" role="menuitem" data-action="win-move" data-app="tingtalk" data-side="left">移到左屏</button><button type="button" role="menuitem" data-action="win-move" data-app="tingtalk" data-side="right" disabled>移到右屏</button></span></span></div><span class="title">汀汀</span></div><div class="body"><div class="wb-msgs"><div class="list"><div class="search">搜索</div><button type="button" class="row on" data-action="conv" data-conv="boss"><span class="av-wrap"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>老板</b><small>[语音] 41″</small></div><div class="meta">09:12<br><span class="n">3</span></div></button><button type="button" class="row" data-action="conv" data-conv="partner"><span class="av-wrap"><img class="av av-img" src="/npc/partner_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>Vivi</b><small>[卡片] 竞品 A 的叙事线 · 转发</small></div><div class="meta">09:30<br><span class="n">1</span></div></button><button type="button" class="row" data-action="conv" data-conv="group"><span class="av-wrap"><img class="av av-img" src="/npc/sil_6.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>未来智能 · 全员</b><small>member：收到+1</small></div><div class="meta">09:21<br><span class="n">5</span></div></button><button type="button" class="row" data-action="conv" data-conv="xiaozhang"><span class="av-wrap"><img class="av av-img" src="/npc/xiaozhang_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>小张</b><small>好嘞老大</small></div><div class="meta">09:41<br><span class="n">2</span></div></button><button type="button" class="row" data-action="conv" data-conv="laozhou"><span class="av-wrap"><img class="av av-img" src="/npc/laozhou_av.png" alt="" aria-hidden="true" draggable="false"></span><div class="t"><b>老周</b><small>你那四份我找着了，在你桌上。</small></div><div class="meta">昨天</div></button></div><div class="conv ding"><div class="head"><b>老板</b> <small>未来智能 · CEO</small></div><div class="msgs"><div class="sysline">第 1 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 08:58</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:1" data-sec="41" data-who="boss" data-text="那个 v17 今天过一下，下午我跟投资人那边要用，你让它先合一版，你看一眼就行，别自己从头弄。你把我们的技术给他们讲清楚：技术表达、技术价值、AI 在我们这儿用出了什么特色。还有那个应收，甲方那边拖了一个月了，你看一眼就行。工资的事我知道，你再等等，一步一步来。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 41″</button><div class="trans">转文字：那个 v17 今天过一下，下午我跟投资人那边要用，你让它先合一版，你看一眼就行，别自己从头弄。你把我们的技术给他们讲清楚：技术表达、技术价值、AI 在我们这儿用出了什么特色。还有那个应收，甲方那边拖了一个月了，你看一眼就行。工资的事我知道，你再等等，一步一步来。</div></div></div><div class="sysline">第 3 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:10</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:3" data-sec="23" data-who="boss" data-text="v17 投资人看了，有想法。下午找你说。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 23″</button><div class="trans">转文字：v17 投资人看了，有想法。下午找你说。</div></div></div><div class="sysline">第 4 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:12</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:5" data-sec="11" data-who="boss" data-text="投资人昨晚把 v18 看了，愿意下场。那边先要三页材料：意识、分身、本体，一天一页。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 11″</button><div class="trans">转文字：投资人昨晚把 v18 看了，愿意下场。那边先要三页材料：意识、分身、本体，一天一页。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:13</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:6" data-sec="15" data-who="boss" data-text="今天写意识。AI 有没有意识，我们要先说。那家公司讲本体，我们讲意识，高一层。你把意识那一节加进去。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 15″</button><div class="trans">转文字：今天写意识。AI 有没有意识，我们要先说。那家公司讲本体，我们讲意识，高一层。你把意识那一节加进去。</div></div></div><div class="sysline">第 5 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:12</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:8" data-sec="41" data-who="boss" data-text="新人的方案群里发了，你别拦，年轻人有想法是好事，一步一步来。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 41″</button><div class="trans">转文字：新人的方案群里发了，你别拦，年轻人有想法是好事，一步一步来。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:13</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:9" data-sec="9" data-who="boss" data-text="那边第二页，分身。Vivi 牵头，你写。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 9″</button><div class="trans">转文字：那边第二页，分身。Vivi 牵头，你写。</div></div></div><div class="sysline">第 6 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:12</div><div class="bub">Good morning. 导出加 CSV，今天。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:30</div><div class="sc sc-file ding"><div class="c-file"><span class="fico x-pdf" aria-hidden="true">PDF</span><div class="c-text"><div class="c-title one">某某科技_商业计划书.pdf</div><div class="c-size">6.9 MB</div></div></div></div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:30</div><div class="bub">你看下这个，先有关系后有东西，他们讲得挺好</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:32</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:14" data-sec="12" data-who="boss" data-text="甲方要一页本体，写它比人古老。人给东西起名字之前，关系就在那儿了。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 12″</button><div class="trans">转文字：甲方要一页本体，写它比人古老。人给东西起名字之前，关系就在那儿了。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:33</div><div class="bub">第三页本体，那边和甲方都要。写一页，两边都给。</div></div></div><div class="sysline">第 7 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:05</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:17" data-sec="19" data-who="boss" data-text="，周会以后改晨会，每天九点，老周主持。纪要你整理，按模板。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 19″</button><div class="trans">转文字：，周会以后改晨会，每天九点，老周主持。纪要你整理，按模板。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:06</div><div class="bub">（转文字）那边派了两位顾问，今天起晨会他们也在。纪要整理好发他们。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 16:40</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:19" data-sec="4" data-who="boss" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 4″</button></div></div><div class="sysline">第 8 天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:00</div><div class="bub">，PDF 我这边只收到两份。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:01</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:22" data-sec="31" data-who="boss" data-text="另外四份你再出一下，它一会儿就好，你看一眼就行。一步一步来。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 31″</button><div class="trans">转文字：另外四份你再出一下，它一会儿就好，你看一眼就行。一步一步来。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:02</div><div class="bub">（转文字）那边周五来，先团建一次。各位领导的祝酒时间你排。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 18:20</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:24" data-sec="0" data-who="boss" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 0″</button></div></div><div class="sysline">昨天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:00</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:26" data-sec="52" data-who="boss" data-text="，两份计费模块今天过，你让它做就行，不用自己读，你自己读要很久。还有，你最近状态不错，继续保持。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 52″</button><div class="trans">转文字：，两份计费模块今天过，你让它做就行，不用自己读，你自己读要很久。还有，你最近状态不错，继续保持。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:01</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:27" data-sec="52" data-who="boss" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 52″</button></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:33</div><div class="bub">我今天去一趟外地往返</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:33</div><div class="bub">再去商量一下科研诚信场景</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:34</div><div class="bub">这个方向可能更大</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:35</div><div class="bub">明天有贵客，线上会议室你布置一下：宫格的座次不能乱，背景统一，散会要有仪式感。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 16:20</div><div class="bub">落地后回家路上我们通个话吧</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 16:21</div><div class="bub">大概我的 6 点？</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 18:35</div><div class="bub">宫格座次你排一下，剧本发给大家排练。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 18:36</div><div class="bub">你也要在。我坐中间。</div></div></div><div class="sysline">今天</div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:00</div><div class="bub">她到了。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:01</div><div class="bub">（转文字）剧本第二幕你校一下，别读太细，错字改了就行。</div></div></div><div class="m"><img class="av av-img" src="/npc/boss_av.png" alt="" aria-hidden="true" draggable="false"><div><div class="who">老板 09:12</div><button type="button" class="voice" data-action="voice-play" data-voice="ding:boss:39" data-sec="41" data-who="boss" data-text="合作协议今天过一下，下午我跟投资人那边要用，你让它先合一版，你看一眼就行，别自己从头弄。" aria-pressed="false"><span class="ding">TING</span><i style="height:6px"></i><i style="height:14px"></i><i style="height:9px"></i><i style="height:16px"></i><i style="height:7px"></i><i style="height:12px"></i> 41″</button><div class="trans">转文字：合作协议今天过一下，下午我跟投资人那边要用，你让它先合一版，你看一眼就行，别自己从头弄。</div></div></div></div><div class="reply"><div class="hint">选一句回复。</div><button type="button" data-conv="boss" class="chip" data-action="chip" data-word="fine">好，我来弄。</button><button type="button" data-conv="boss" class="chip" data-action="chip" data-word="received">收到。</button><button type="button" data-conv="boss" class="chip gone" data-action="gone" data-word="whatever">您定。</button><button type="button" data-conv="boss" class="chip" data-action="chip" data-word="salary">工资那边有信儿了吗。</button><button type=