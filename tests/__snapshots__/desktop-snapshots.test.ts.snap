exports[`desktop snapshots (requirements §3) > day 1 morning: 浏览器 1`] = `"<div class="stage one-monitor" data-day="1" data-beat="boot" data-focus="left"><div class="screen-toggle"><button type="button" class="on" data-action="screen" data-screen="left">左屏</button><button type="button" class="" data-action="screen" data-screen="right">右屏</button></div><div class="monitor" data-side="left" data-ring="software" data-app="browser"><div class="os"><div class="top"><span class="brand">新世界</span><span>浏览器</span><div class="day"><span>第 1 天 · 早上 10:00</span><span>☁ 雨</span><span class="kuro-dot" title="在线"></span><span>Kuro</span><button type="button" class="sys-off" data-action="desktop-shutdown" disabled>关机</button></div></div><div class="win br" style="left:24px;top:54px;width:1392px;height:760px"><div class="bar"><div class="dots"><i></i><i></i><i></i></div><div class="url">今日 · 科技</div></div><div class="body" style="flex-direction:column"><div class="site"><div class="mast"><b>今日</b><small>科技 · 第 1 天 · 阴，有雨</small></div><div class="nav"><span>要闻</span><span style="color:var(--accent)">AI</span><span>就业</span><span>公司</span><span>评论</span><span>本地</span></div><div class="grid"><div class="lead"><h2>「它比我更懂我」：桌面助手上线一个月，用户留存 97%</h2><p>新一代桌面助手把消息、文档、表格、代码合在一个工作台里。受访用户说，它记得自己几点喝水、几点起床，「像一个不会累的同事」。厂商称，助手在过去三十天里没有一次说「不」。</p><p>评论区里点赞最多的一条：「我终于不用自己看一眼了。」</p></div><div><div class="num down"><b>41 万</b><small>本季度 AI 相关岗位调整人数 · 较上季 +18%</small></div><div class="num up"><b>97%</b><small>桌面助手月留存 · 创纪录</small></div><div class="num"><b>12 条</b><small>本周更新日志条数</small></div></div><div class="list"><h3>读者在读</h3><button type="button" class="read" data-action="br-open" data-i="0">公司发全员信：「AI 原生改革」完成，办公室不再续租<small>公司 · 2 小时前</small></button><button type="button" class="read" data-action="br-open" data-i="1">「我们没有裁人，我们换了方式」：一位 CEO 的三小时饭局<small>人物 · 昨天</small></button><button type="button" class="read" data-action="br-open" data-i="2">助手写的需求文档通过率 100%，评审环节取消<small>AI · 昨天</small></button><button type="button" class="read" data-action="br-open" data-i="3">一款 1997 年的仿制电子宠物在旧货市场涨价<small>本地 · 3 天前</small></button><button type="button" class="read" data-action="br-open" data-i="4">雨季第十一天，本市降水量追平 1997 年<small>本地 · 今天</small></button></div></div><div class="foot">2026-10-31</div></div></div></div><div class="dock"><button type="button" class="app msgs" data-action="dock" data-app="msgs" title="消息" aria-label="消息"><img src="/os/msgs.svg" alt="" draggable="false" width="64" height="64"><span class="badge">4</span><span class="dock-name" aria-hidden="true">消息</span></button><button type="button" class="app docs" data-action="dock" data-app="workbench" title="工作台" aria-label="工作台"><img src="/os/workbench.svg" alt="" draggable="false" width="64" height="64"><span class="badge">6</span><span class="dock-name" aria-hidden="true">工作台</span></button><button type="button" class="app feed on" data-action="dock" data-app="browser" title="浏览器" aria-label="浏览器"><img src="/os/browser.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">浏览器</span></button><span class="sep" role="separator"></span><button type="button" class="app decoy" data-action="decoy" data-decoy="claude" title="Claude" aria-label="Claude"><img src="/os/claude.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">Claude</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="files" title="文件" aria-label="文件"><img src="/os/files.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">文件</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="trash" title="回收站" aria-label="回收站"><img src="/os/trash.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">回收站</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="settings" title="设置" aria-label="设置"><img src="/os/settings.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">设置</span></button><button type="button" class="app decoy" data-action="decoy" data-decoy="calendar" title="日历" aria-label="日历"><img src="/os/calendar.svg" alt="" draggable="false" width="64" height="64"><span class="dock-name" aria-hidden="true">日历</span></button></div><button type="button" class="kpill" data-action="kuro-call" aria-label="Kuro"><img src="/kuro/k3d_base.png" alt=""><span class="ln">Good to see you.</span><span class="on">在线</span><span class="turns">今天 0/5</span></button></div></div><button type="button" class="other-tab" data-side="right" data-action="screen" data-screen="right"><span class="tab-app docs">工作台<b>6</b></span></button></div>"`;

