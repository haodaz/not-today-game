// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FR1 the box: snapshots > a narration line: one screen, ▶, the ↺ chip, no tag 1`] = `"<div class="dlg" data-screen="1/1"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">下雨了。在家上班，不失为一个好选择。</button><span class="more" aria-hidden="true">▶</span></div>"`;

exports[`FR1 the box: snapshots > a paged line: ▼ on the first page, ▶ on the last; a click shows the next page, never scrolls 1`] = `"<div class="dlg" data-screen="1/5"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">早上好。这是克总，我的 AI。看看今天要干什么，跟着任务走没错。下雨了。在家上班，不失为一个好选择。桌上一杯水，凉的。两块屏黑着。新一天的活，从开机开始。袋子旁边还有一个纸箱，没有寄件人。……这是买一送一了吗。我把它们都拿进来了。外卖先放在小桌上。我打开了纸箱。纸箱里面是九个小盒子。这是盲盒吗？总之，</button><span class="more" aria-hidden="true">▼</span></div>"`;

exports[`FR1 the box: snapshots > a paged line: ▼ on the first page, ▶ on the last; a click shows the next page, never scrolls 2`] = `"<div class="dlg" data-screen="5/5"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">递成绩单，一百。再递它，屏幕上已经是那座坟。看，还是收了对。是收走的。不是我不喂。后来你按过背面那个小孔。没有用。它一直是坟。很长一段时间，电快用完的时候你就换上新的。想着哪一天，小鸡会活过来。今天过去了。</button><span class="more" aria-hidden="true">▶</span></div>"`;

exports[`FR1 the box: snapshots > history: ↺ opens today's lines and choices, tagged; a click outside, 关闭 or Esc closes; a new day clears it 1`] = `"<div class="dlg tagged kuro" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance"><span class="kmono">Good to see you.</span></button><span class="more" aria-hidden="true">▶</span><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-hist-layer"><button type="button" class="dlg-hist-dim" data-action="dlg-history-close" aria-label="关闭"></button><section class="dlg-hist" role="dialog" aria-modal="true" aria-labelledby="dlg-hist-h"><h3 id="dlg-hist-h">本次对话</h3><ol><li class="h-it k-kuro"><b>Kuro</b><span>要和克总聊聊吗？</span></li><li class="h-it k-player"><b>林一</b><span>聊聊</span></li><li class="h-it k-kuro"><b>Kuro</b><span>Good to see you.</span></li></ol><button type="button" class="close" data-action="dlg-history-close">关闭</button></section></div>"`;

exports[`FR2 talking to Kuro > the body opens the prompt (snapshot): tag with its face, 要和克总聊聊吗？, 聊聊 / 先不聊; 先不聊 closes 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt">要和克总聊聊吗？</div><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="loop-choice" data-index="0" data-choice="yes" data-focus="dc-0" data-n="1"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">聊聊</span></button><button type="button" class="dc-row" data-action="loop-choice" data-index="1" data-choice="no" data-focus="dc-1" data-n="2"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">先不聊</span></button></div>"`;

exports[`FR2 talking to Kuro > 聊聊 at night: Kuro's line with its face, then the player's box: the starters and 说点别的… on one page (snapshot) 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt"><span class="kmono">Good to see you.</span></div><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="kuro-q" data-q="101" data-focus="dc-0" data-n="1"><i class="dc-ic ask" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M2 2.5h10a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1H6.2L3.4 12.3V10H2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">你今天这几件，哪件最烦？</span></button><button type="button" class="dc-row" data-action="kuro-q" data-q="102" data-focus="dc-1" data-n="2"><i class="dc-ic ask" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M2 2.5h10a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1H6.2L3.4 12.3V10H2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">你怎么知道哪两条不一致？</span></button><button type="button" class="dc-row" data-action="kuro-q" data-q="103" data-focus="dc-2" data-n="3"><i class="dc-ic ask" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M2 2.5h10a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1H6.2L3.4 12.3V10H2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">老板说「让它先合，你看一眼就行」。你怎么看这句话？</span></button><button type="button" class="dc-row" data-action="kuro-q" data-q="104" data-focus="dc-3" data-n="4"><i class="dc-ic ask" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M2 2.5h10a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1H6.2L3.4 12.3V10H2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">你叫什么？克总是我们给你起的。</span></button><button type="button" class="dc-row" data-action="kuro-q" data-q="105" data-focus="dc-4" data-n="5"><i class="dc-ic ask" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M2 2.5h10a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1H6.2L3.4 12.3V10H2a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">应收表那个数，你早就看见了吧？</span></button><button type="button" class="dc-row" data-action="kuro-page" data-focus="dc-5" data-n="6"><i class="dc-ic more" aria-hidden="true"><svg viewBox="0 0 14 14" width="14" height="14"><path d="M9.6 1.9l2.5 2.5-7.4 7.4-3.1.6.6-3.1z M8.4 3.1l2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg></i><span class="dc-l">说点别的…</span></button></div>"`;
