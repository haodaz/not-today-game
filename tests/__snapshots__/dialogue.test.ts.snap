// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FR1 the box: snapshots > a narration line: one screen, ▶, the ↺ chip, no tag 1`] = `"<div class="dlg" data-screen="1/1"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">雨。窗玻璃上三层声音都在。</button><span class="more" aria-hidden="true">▶</span></div>"`;

exports[`FR1 the box: snapshots > a paged line: ▼ on the first page, ▶ on the last; a click shows the next page, never scrolls 1`] = `"<div class="dlg" data-screen="1/2"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">雨。窗玻璃上三层声音都在。桌上一杯水，凉的。两块屏黑着。第一天。或者第四百天，看怎么数。叮咚。门口两样东西：一袋黄焖鸡，一个没有寄件人的纸箱。箱子上有收件人，是你的名字。你把它放在两块屏之间，放进那条缝里。刚好卡住，不倒。旧得和这个房间不是一个年代的东西。灯灭了，或者说，你关了屏幕。屋子一下子沉下去</button><span class="more" aria-hidden="true">▼</span></div>"`;

exports[`FR1 the box: snapshots > a paged line: ▼ on the first page, ▶ on the last; a click shows the next page, never scrolls 2`] = `"<div class="dlg" data-screen="2/2"><div class="tagbar"><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">。没有手从缝里伸出来。今天还没有。那道黑里有一点光。不是小鸡的壳，壳在更低的地方。它在缝的中间，很小，偏粉。你数到七，它还在。粉的。我这屋子里没有一样东西是粉的。今天过去了。</button><span class="more" aria-hidden="true">▶</span></div>"`;

exports[`FR1 the box: snapshots > choices render in the box (◆ by CSS), one page of at most four; a speaker's line carries its tag 1`] = `"<div class="dlg tagged has-choices" data-screen="2/3"><div class="tagbar"><span class="who tag">缝里</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="choices"><button type="button" data-action="loop-choice" data-index="0">一</button><button type="button" data-action="loop-choice" data-index="1">二</button><button type="button" data-action="loop-choice" data-index="2">三</button><button type="button" data-action="loop-choice" data-index="3">四</button></div><button type="button" class="more" data-action="loop-advance">▼</button></div>"`;

exports[`FR1 the box: snapshots > history: ↺ opens today's lines and choices, tagged; a click outside, 关闭 or Esc closes; a new day clears it 1`] = `"<div class="dlg tagged kuro raised" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">Good to see you.</button><span class="more" aria-hidden="true">▶</span><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-player" data-mode="choices" data-screen="1/1"><span class="who tag p">林一</span><div class="choices"><button type="button" data-action="kuro-q" data-q="1">你今天这几件，哪件最烦？</button><button type="button" data-action="kuro-q" data-q="2">你怎么知道哪两条不一致？</button><button type="button" data-action="kuro-q" data-q="3">今天雨挺大。</button><button type="button" data-action="kuro-q" data-q="4">你叫什么？克总是我们给你起的。</button><button type="button" data-action="kuro-more">说点别的…</button></div></div><div class="dlg-hist-layer"><button type="button" class="dlg-hist-dim" data-action="dlg-history-close" aria-label="关闭"></button><section class="dlg-hist" role="dialog" aria-modal="true" aria-labelledby="dlg-hist-h"><h3 id="dlg-hist-h">本次对话</h3><ol><li class="h-it k-kuro"><b>Kuro</b><span>要和克总聊聊吗？</span></li><li class="h-it k-player"><b>林一</b><span>聊聊</span></li><li class="h-it k-kuro"><b>Kuro</b><span>Good to see you.</span></li></ol><button type="button" class="close" data-action="dlg-history-close">关闭</button></section></div>"`;

exports[`FR2 talking to Kuro > a starter is a turn: a chat event, the offline answer, the question gone from the list; typing sends with Enter 1`] = `"<div class="dlg tagged kuro raised" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">The receivable. One cell, ten seconds, and you&#39;ve been putting it off since nine. I&#39;d have done it in four.</button><span class="more" aria-hidden="true">▶</span><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-player input" data-mode="input"><span class="who tag p">林一</span><input class="kuro-in" type="text" data-input="kuro-text" data-focus="kuro-text" data-enter="kuro-send" maxlength="500" value="" aria-label="说点别的…" autocomplete="off" spellcheck="false"></div>"`;

exports[`FR2 talking to Kuro > the body opens the prompt (snapshot): tag with its face, 要和克总聊聊吗？, 聊聊 / 先不聊; 先不聊 closes 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">要和克总聊聊吗？</button><div class="choices"><button type="button" data-action="loop-choice" data-index="0" data-choice="yes">聊聊</button><button type="button" data-action="loop-choice" data-index="1" data-choice="no">先不聊</button></div><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div>"`;

exports[`FR2 talking to Kuro > 聊聊 at night: Kuro's line with its face, then the player's box: the starters and 说点别的… on one page (snapshot) 1`] = `"<div class="dlg tagged kuro raised" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><button type="button" class="txt" data-action="loop-advance">Good to see you.</button><span class="more" aria-hidden="true">▶</span><span class="kpet kuro-portrait" data-kuro-slot data-state="rest" aria-hidden="true"></span></div><div class="dlg-player" data-mode="choices" data-screen="1/1"><span class="who tag p">林一</span><div class="choices"><button type="button" data-action="kuro-q" data-q="1">你今天这几件，哪件最烦？</button><button type="button" data-action="kuro-q" data-q="2">你怎么知道哪两条不一致？</button><button type="button" data-action="kuro-q" data-q="3">今天雨挺大。</button><button type="button" data-action="kuro-q" data-q="4">你叫什么？克总是我们给你起的。</button><button type="button" data-action="kuro-more">说点别的…</button></div></div>"`;
