// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FR5 checklist snapshots > day 1 after lunch arrives 1`] = `"<div class="list"><div class="h">今日</div><div class="done">已做 3 件</div><div class="it now" data-id="task1"><i></i>v17 过一遍。</div><div class="it next" data-id="pickup"><i></i>去拿。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 after ordering lunch 1`] = `"<div class="list"><div class="h">今日</div><div class="done">已做 2 件</div><div class="it now" data-id="task1"><i></i>v17 过一遍。</div><div class="it wait" data-id="lunch"><i></i>午饭在路上。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 at boot 1`] = `"<div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div>"`;

exports[`FR5 checklist snapshots > day 17 with the item that ticked itself 1`] = `
{
  "after": "<div class="list"><div class="h">今日</div><div class="done">已做 3 件</div><div class="it now" data-id="reply"><i></i>回老板。</div></div>",
  "before": "<div class="list"><div class="h">今日</div><div class="done">已做 2 件</div><div class="it now" data-id="task1"><i></i>把东西放回去。</div></div>",
}
`;

exports[`FR5 checklist snapshots > day 18 at its last item 1`] = `"<div class="list"><div class="h">今日</div><div class="done">已做 8 件</div><button type="button" class="it now" data-action="loop-item" data-id="bed"><i></i>躺下。</button></div>"`;

exports[`room HUD (FR6) > day 1: checklist, day and overdue, desk bar, cameras, menu; no heart rate 1`] = `"<div class="stage room room-view" data-day="1" data-view="room" data-san-band="0"><button type="button" class="shot-hit" data-action="view" data-view="desk" style="left:215px;top:290px;width:824px;height:330px" aria-label="桌子"></button><div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div><div class="day"><b>第 1 天 · 早上</b><span class="ov">拖欠 31 天</span></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="idle" aria-hidden="true"></span></button></div><div class="cams"><button type="button" class="on" data-action="view" data-view="room">房间</button><button type="button" class="" data-action="view" data-view="desk">桌子</button><button type="button" class="" data-action="view" data-view="desktop">屏幕</button><button type="button" class="" data-action="view" data-view="door">门</button></div></div><button type="button" class="settings-btn" data-action="settings-open" aria-haspopup="dialog">⚙ 设置</button></div>"`;

exports[`room HUD (FR6) > the heart-rate chip appears from day 9 and rises as SAN falls; SAN is never shown 1`] = `"<div class="stage room room-view" data-day="9" data-view="room" data-san-band="0"><button type="button" class="shot-hit" data-action="view" data-view="desk" style="left:215px;top:290px;width:824px;height:330px" aria-label="桌子"></button><div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div><div class="day"><b>第 9 天 · 早上</b><span class="ov">拖欠 39 天</span></div><div class="hr"><i></i>72 bpm</div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="idle" aria-hidden="true"></span></button></div><div class="cams"><button type="button" class="on" data-action="view" data-view="room">房间</button><button type="button" class="" data-action="view" data-view="desk">桌子</button><button type="button" class="" data-action="view" data-view="desktop">屏幕</button><button type="button" class="" data-action="view" data-view="door">门</button></div></div><button type="button" class="settings-btn" data-action="settings-open" aria-haspopup="dialog">⚙ 设置</button></div>"`;
