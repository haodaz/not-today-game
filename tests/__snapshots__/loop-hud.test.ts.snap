// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FR5 checklist snapshots > day 1 after lunch arrives 1`] = `"<div class="list"><div class="h">今日</div><div class="it now" data-id="work"><i class="mark" aria-hidden="true">▸</i>把今天的活干完（0/3）</div><div class="it later" data-id="pickup">去门口拿。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 after ordering lunch 1`] = `"<div class="list"><div class="h">今日</div><div class="it now" data-id="work"><i class="mark" aria-hidden="true">▸</i>把今天的活干完（0/3）</div><div class="it wait" data-id="lunch">午饭在路上。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 at boot 1`] = `"<div class="list"><div class="h">今日</div><div class="it now" data-id="boot"><i class="mark" aria-hidden="true">▸</i>按一下桌底下的主机，开机。</div></div>"`;

exports[`FR5 checklist snapshots > day 17 with the item that ticked itself 1`] = `
{
  "after": "<div class="list"><div class="h">今日</div><div class="it now" data-id="work"><i class="mark" aria-hidden="true">▸</i>把今天的活干完（1/2）</div><div class="it later" data-id="reply">回老板。</div></div>",
  "before": "<div class="list"><div class="h">今日</div><div class="it now" data-id="work"><i class="mark" aria-hidden="true">▸</i>把今天的活干完（0/2）</div></div>",
}
`;

exports[`FR5 checklist snapshots > day 18 at its last item 1`] = `"<div class="list"><div class="h">今晚</div><div class="it now" data-id="bed"><i class="mark" aria-hidden="true">▸</i>躺下。</div></div>"`;

