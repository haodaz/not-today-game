// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`FR5 checklist snapshots > day 1 after lunch arrives 1`] = `"<div class="list"><div class="h">今日</div><div class="done">已做 3 件</div><div class="it now"><i></i>v17 过一遍。</div><div class="it next"><i></i>去拿。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 after ordering lunch 1`] = `"<div class="list"><div class="h">今日</div><div class="done">已做 2 件</div><div class="it now"><i></i>v17 过一遍。</div><div class="it wait"><i></i>午饭在路上。</div></div>"`;

exports[`FR5 checklist snapshots > day 1 at boot 1`] = `"<div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div>"`;

exports[`FR5 checklist snapshots > day 17 with the item that ticked itself 1`] = `
{
  "after": "<div class="list"><div class="h">今日</div><div class="done">已做 3 件</div><div class="it now"><i></i>回老板。</div></div>",
  "before": "<div class="list"><div class="h">今日</div><div class="done">已做 2 件</div><div class="it now"><i></i>把东西放回去。</div></div>",
}
`;

exports[`room HUD (FR6) > day 1: checklist, day and overdue, desk bar, cameras, menu; no heart rate 1`] = `"<div class="stage room no-shot" data-day="1" data-view="room"><div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div><div class="day"><b>第 1 天 · 早上</b><span class="ov">拖欠 31 天</span></div><div class="bar"><button type="button" class="slot" data-action="loop-box"><div class="box"></div><span>剩 8 层</span></button><button type="button" class="slot" data-action="loop-phone"><div class="phone"></div><span>手机</span></button><div class="slot"><div class="cup"></div></div></div><div class="cams"><button type="button" class="on" data-action="view" data-view="room">房间</button><button type="button" class="" data-action="view" data-view="desktop">桌面</button><button type="button" class="" data-action="view" data-view="door">门</button></div><div class="menu"><button type="button" class="" data-action="loop-mute">声音</button>·<button type="button" data-action="loop-lang">语言</button>·<button type="button" data-action="loop-restart">重新开始</button></div></div>"`;

exports[`room HUD (FR6) > the heart-rate chip appears from day 9 and rises as SAN falls; SAN is never shown 1`] = `"<div class="stage room no-shot" data-day="9" data-view="room"><div class="list"><div class="h">今日</div><button type="button" class="it now" data-action="loop-item" data-id="boot"><i></i>开机。</button></div><div class="day"><b>第 9 天 · 早上</b><span class="ov">拖欠 39 天</span></div><div class="hr"><i></i>72 bpm</div><div class="bar"><button type="button" class="slot" data-action="loop-box"><div class="box"></div><span>剩 8 层</span></button><button type="button" class="slot" data-action="loop-phone"><div class="phone"></div><span>手机</span></button><div class="slot"><div class="cup"></div></div></div><div class="cams"><button type="button" class="on" data-action="view" data-view="room">房间</button><button type="button" class="" data-action="view" data-view="desktop">桌面</button><button type="button" class="" data-action="view" data-view="door">门</button></div><div class="menu"><button type="button" class="" data-action="loop-mute">声音</button>·<button type="button" data-action="loop-lang">语言</button>·<button type="button" data-action="loop-restart">重新开始</button></div></div>"`;
