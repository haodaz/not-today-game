exports[`the pages > the reader's markup: the spread, the page numbers in the outer corners, the halves, the close chip; nothing scrolls 1`] = `"<div class="book-reader diary" role="dialog" aria-modal="true" aria-label="床头的书"><div class="bk-dim"></div><div class="bk-spread" data-spread="1" data-spreads="3"><div class="bk-page left" data-day="2"><div class="bk-body"><h3 class="bk-head">第 2 天</h3><p class="bk-weather">雨。</p><p>问它：第0句第0句第0句第0句第0句第0句第0句第0句　它说：好。</p><p>问它：第1句第1句第1句第1句第1句第1句第1句第1句　它说：好。</p><p>问它：第2句第2句第2句第2句第2句第2句第2句第2句　它说：好。</p><p>问它：第3句第3句第3句第3句第3句第3句第3句第3句　它说：好。</p><p>问它：第4句第4句第4句第4句第4句第4句第4句第4句　它说：好。</p><p>问它：第5句第5句第5句第5句第5句第5句第5句第5句　它说：好。</p><p>问它：第6句第6句第6句第6句第6句第6句第6句第6句　它说：好。</p><p>问它：第7句第7句第7句第7句第7句第7句第7句第7句　它说：好。</p></div><span class="bk-no">3</span></div><div class="bk-page right" data-day="2"><div class="bk-body"><p>问它：第8句第8句第8句第8句第8句第8句第8句第8句　它说：好。</p><p>问它：第9句第9句第9句第9句第9句第9句第9句第9句　它说：好。</p><p>问它：第10句第10句第10句第10句第10句第10句第10句第10句　它说：好。</p><p>问它：第11句第11句第11句第11句第11句第11句第11句第11句　它说：好。</p><p>今天到这里。</p></div><span class="bk-no">4</span></div><i class="bk-gutter" aria-hidden="true"></i><button type="button" class="bk-turn prev" data-action="book-turn" data-by="-1" tabindex="-1" aria-hidden="true"></button><button type="button" class="bk-turn next" data-action="book-turn" data-by="1" tabindex="-1" aria-hidden="true"></button></div><button type="button" class="book-close" data-action="book-close">关闭</button></div>"`;
