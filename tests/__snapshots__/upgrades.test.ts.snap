exports[`offers (FR1) > declining hides it; the nag comes once, nagAfterDays later (day 8) 1`] = `"<div class="kmini"><div class="h"><img src="/kuro/k3d_base.png" alt=""><b>Kuro</b><span>在线</span><span class="turns">今天 0/5</span></div><div class="c"><div class="it">Let&#39;s keep things simple today.</div><div class="offer" data-offer="nag" data-object="pager"><div class="it">Another string came in last night. I could just tell you what it says.</div><div class="offer-btns"><button type="button" data-action="upgrade-yes" data-object="pager">升级</button><button type="button" data-action="upgrade-no" data-object="pager" data-decline="nag">不用</button></div></div></div><div class="qs"><button type="button" data-action="kuro-ask" data-q="1">PDF 为什么是白的？</button><button type="button" data-action="kuro-ask" data-q="2">我做了。我知道我做了。</button><button type="button" data-action="kuro-ask" data-q="3">你数我几点睡干什么？</button></div><div class="in">和克总说点别的…</div></div>"`;

