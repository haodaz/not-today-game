// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`offers (FR1) > declining hides it; the nag comes once, nagAfterDays later (day 8) 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">克总</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt">昨晚又来了一串。我直接告诉你说的什么就行。</div><span class="kpet kuro-portrait" data-kuro-slot data-state="talk" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="loop-choice" data-index="0" data-choice="yes" data-focus="dc-0" data-n="1"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">升级</span></button><button type="button" class="dc-row" data-action="loop-choice" data-index="1" data-choice="no" data-focus="dc-1" data-n="2"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">不用</span></button></div>"`;

exports[`offers (FR1) > pager offer on day 5: Kuro's first line in the box, with 升级 / 不了; then it asks to talk 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">克总</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt">那些数字，我直接帮你念成字。不用查表。</div><span class="kpet kuro-portrait" data-kuro-slot data-state="talk" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="loop-choice" data-index="0" data-choice="yes" data-focus="dc-0" data-n="1"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">升级</span></button><button type="button" class="dc-row" data-action="loop-choice" data-index="1" data-choice="no" data-focus="dc-1" data-n="2"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">不用</span></button></div>"`;

exports[`what upgrading changes (FR2) and FR3 properties > the desk bar shows an upgraded object with its hi-res icon (snapshot); lost objects are not on it 1`] = `"class="desk-things"><div class="at" data-at="cup" style="left:1070px;top:560px;width:150px;height:150px"><div class="slot"><img class="desk-photo cup" src="/room/desk/cup.png" alt="" aria-hidden="true"></div></div><div class="at" data-at="phone" style="left:1230px;top:450px;width:130px;height:200px"><button type="button" class="slot" data-action="loop-phone"><img class="desk-photo" src="/room/desk/phone.png" alt="" aria-hidden="true"><span>手机</span></button></div><div class="at" data-at="object:chick" style="left:120px;top:290px;width:170px;height:130px"><button type="button" class="slot unknown pointer-once" data-object="chick" data-action="loop-hold"><img src="/objects/chick_white.png" alt=""><div class="lcd" data-screen="chick"></div></button></div><div class="at" data-at="object:pager" style="left:330px;top:290px;width:170px;height:130px"><button type="button" class="slot upgraded unknown" data-object="pager" data-res="hi" data-action="loop-hold"><img src="/objects/pager_front.png" alt=""><div class="screen-hi" data-screen="pager"></div></button></div></div><button type="button" class="go-pill back-pill" data-action="nav-back"><i class="chev"></i><span>离开桌子</span></button><div class="hud-left"><div class="hud-card"><div class="day"><svg class="day-rune" viewBox="-32 -32 64 64" aria-hidden="true"><circle r="17"/><circle r="11" stroke-dasharray="2 3"/><path d="M-11 0Q0-7 11 0Q0 7-11 0Z"/><circle r="2.6" fill="currentColor" stroke="none"/></svg><b>第 4 天</b><small><em>早上</em>09:03</small></div><svg class="gm-ruler" viewBox="0 0 330 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5H330" stroke-opacity=".6"/><path d="M0 0V10" stroke-opacity="0.5"/><path d="M10 3V7" stroke-opacity="0.5"/><path d="M20 3V7" stroke-opacity="0.5"/><path d="M30 3V7" stroke-opacity="0.5"/><path d="M40 3V7" stroke-opacity="0.5"/><path d="M50 0V10" stroke-opacity="0.5"/><path d="M60 3V7" stroke-opacity="0.5"/><path d="M70 3V7" stroke-opacity="0.5"/><path d="M80 3V7" stroke-opacity="0.5"/><path d="M90 3V7" stroke-opacity="0.5"/><path d="M100 0V10" stroke-opacity="0.5"/><path d="M110 3V7" stroke-opacity="0.5"/><path d="M120 3V7" stroke-opacity="0.5"/><path d="M130 3V7" stroke-opacity="0.5"/><path d="M140 3V7" stroke-opacity="0.5"/><path d="M150 0V10" stroke-opacity="0.5"/><path d="M160 3V7" stroke-opacity="0.5"/><path d="M170 3V7" stroke-opacity="0.5"/><path d="M180 3V7" stroke-opacity="0.5"/><path d="M190 3V7" stroke-opacity="0.5"/><path d="M200 0V10" stroke-opacity="0.5"/><path d="M210 3V7" stroke-opacity="0.5"/><path d="M220 3V7" stroke-opacity="0.5"/><path d="M230 3V7" stroke-opacity="0.5"/><path d="M240 3V7" stroke-opacity="0.5"/><path d="M250 0V10" stroke-opacity="0.5"/><path d="M260 3V7" stroke-opacity="0.5"/><path d="M270 3V7" stroke-opacity="0.5"/><path d="M280 3V7" stroke-opacity="0.5"/><path d="M290 3V7" stroke-opacity="0.5"/><path d="M300 0V10" stroke-opacity="0.5"/><path d="M310 3V7" stroke-opacity="0.5"/><path d="M320 3V7" stroke-opacity="0.5"/><path d="M330 3V7" stroke-opacity="1" stroke="#c0372e"/></svg><div class="list" aria-label="今日"><div class="it now" data-id="boot"><i class="mark" aria-hidden="true">▸</i><span class="txt">先把电脑开了。<button type="button" class="go" data-action="go-item" data-id="boot">前往<i aria-hidden="true">›</i></button></span></div></div></div></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn" data-action="kuro-call" aria-label="克总"><span class="kpet" data-kuro-slot data-state="idle" aria-hidden="true"></span></button></div></div><div class="hud-tiles"><span class="tile-wrap"><button type="button" class="med status-btn" data-action="status-open" aria-haspopup="dialog" aria-expanded="false" title="人物" aria-label="人物"><span class="disc" aria-hidden="true"><svg viewBox="-32 -32 64 64"><g class="ring"><circle r=