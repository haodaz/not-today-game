// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`offers (FR1) > declining hides it; the nag comes once, nagAfterDays later (day 8) 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt">昨晚又来了一串。我直接告诉你说的什么就行。</div><span class="kpet kuro-portrait" data-kuro-slot data-state="talk" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="loop-choice" data-index="0" data-choice="yes" data-focus="dc-0" data-n="1"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">升级</span></button><button type="button" class="dc-row" data-action="loop-choice" data-index="1" data-choice="no" data-focus="dc-1" data-n="2"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">不用</span></button></div>"`;

exports[`offers (FR1) > pager offer on day 5: Kuro's first line in the box, with 升级 / 不了; then it asks to talk 1`] = `"<div class="dlg tagged kuro has-choices" data-screen="1/1"><div class="tagbar"><span class="who tag k">Kuro</span><button type="button" class="hist" data-action="dlg-history" aria-haspopup="dialog" aria-label="本次对话">↺</button></div><div class="txt">那些数字，我直接帮你念成字。不用查表。</div><span class="kpet kuro-portrait" data-kuro-slot data-state="talk" aria-hidden="true"></span></div><div class="dlg-choices" role="group"><button type="button" class="dc-row" data-action="loop-choice" data-index="0" data-choice="yes" data-focus="dc-0" data-n="1"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">升级</span></button><button type="button" class="dc-row" data-action="loop-choice" data-index="1" data-choice="no" data-focus="dc-1" data-n="2"><i class="dc-ic plain" aria-hidden="true">◇</i><span class="dc-l">不用</span></button></div>"`;

exports[`what upgrading changes (FR2) and FR3 properties > the desk bar shows an upgraded object with its hi-res icon (snapshot); lost objects are not on it 1`] = `"class="desk-things"><div class="at" data-at="cup" style="left:1070px;top:560px;width:150px;height:150px"><div class="slot"><img class="desk-photo cup" src="/room/desk/cup.png" alt="" aria-hidden="true"></div></div><div class="at" data-at="phone" style="left:1230px;top:450px;width:130px;height:200px"><button type="button" class="slot" data-action="loop-phone"><img class="desk-photo" src="/room/desk/phone.png" alt="" aria-hidden="true"><span>手机</span></button></div><div class="at" data-at="object:chick" style="left:120px;top:290px;width:170px;height:130px"><button type="button" class="slot unknown pointer-once" data-object="chick" data-action="loop-hold"><img src="/objects/chick_white.png" alt=""><div class="lcd" data-screen="chick"></div></button></div><div class="at" data-at="object:pager" style="left:330px;top:290px;width:170px;height:130px"><button type="button" class="slot upgraded unknown" data-object="pager" data-res="hi" data-action="loop-hold"><img src="/objects/pager_front.png" alt=""><div class="screen-hi" data-screen="pager"></div></button></div></div><div class="list"><div class="h">今日</div><div class="it now" data-id="boot"><i class="mark" aria-hidden="true">▸</i>开机。</div></div><div class="day"><b>第 4 天 · 早上</b></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn pointer-once" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="idle" aria-hidden="true"></span></button></div></div><div class="hud-tiles"><button type="button" class="status-btn" data-action="status-open" aria-haspopup="dialog" aria-expanded="false"><svg class="tile-ic" viewBox="0 0 16 16" width="24" height="24" shape-rendering="crispEdges" aria-hidden="true"><path d="M6 1h1v1h-1zM7 1h1v1h-1zM8 1h1v1h-1zM9 1h1v1h-1zM5 2h1v1h-1zM6 2h1v1h-1zM7 2h1v1h-1zM8 2h1v1h-1