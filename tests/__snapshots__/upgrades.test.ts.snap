exports[`what upgrading changes (FR2) and FR3 properties > the desk bar shows an upgraded object with its hi-res icon (snapshot); lost objects are not on it 1`] = `"class="bar"><button type="button" class="slot" data-action="loop-box"><div class="box"></div><span>剩 6 层</span></button><button type="button" class="slot" data-action="loop-phone"><div class="phone"></div><span>手机</span></button><div class="slot"><div class="cup"></div></div><button type="button" class="slot unknown pointer-once" data-object="chick" data-action="loop-hold"><img src="/objects/chick_white.png" alt=""><div class="lcd" data-screen="chick"></div></button><button type="button" class="slot upgraded unknown" data-object="pager" data-res="hi" data-action="loop-hold"><img src="/objects/pager_front.png" alt=""><div class="screen-hi" data-screen="pager"></div></button></div><div class="hud-br"><div class="hud-kuro"><button type="button" class="kuro-btn pointer-once" data-action="kuro-call" aria-label="Kuro"><span class="kpet" data-kuro-slot data-state="idle" aria-hidden="true"></span></button></div><div class="cams"><button type="button" class="" data-action="view" data-view="room">房间</button><button type="button" class="on" data-action="view" data-view="desk">桌子</button><button type="button" class="" data-action="view" data-view="desktop">屏幕</button><button type="button" class="" data-action="view" data-view="door">门</button></div></div><button type="button" class="settings-btn" data-action="settings-open" aria-haspopup="dialog">⚙ 设置</button></div>"`;
