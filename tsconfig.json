{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@content/*": ["./content/*"],
      "@state/*": ["./src/state/*"],
      "@world/*": ["./src/world/*"],
      "@kuro/*": ["./supabase/functions/_shared/kuro/*"],
      "@net/*": ["./src/net/*"]
    }
  },
  "include": ["src", "content", "scripts", "tests", "vite.config.ts", "supabase/functions/_shared"]
}
